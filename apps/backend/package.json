{
  "name": "@repo/backend",
  "type": "module",
  "exports": {
    "./hc": {
      "import": {
        "types": "./dist/hc.d.ts",
        "default": "./dist/hc.js"
      }
    }
  },
  "scripts": {
    "dev": "pnpm --filter @repo/backend --parallel \"/^dev:.*/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch",
    "dev:wrangler": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "tsc -p tsconfig.build.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.4",
    "@hono/clerk-auth": "^3.1.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.4",
    "@neondatabase/serverless": "^1.0.2",
    "@repo/shared": "workspace:*",
    "consola": "^3.4.2",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "wrangler": "^4.79.0"
  }
}
